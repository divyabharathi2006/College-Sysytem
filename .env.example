# Copy to .env and use unique local values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=
UNIVERSITY_STUDENTS_DATABASE_URL=
AFFILIATED_STUDENTS_DATABASE_URL=
AFFILIATED_COLLEGES_DATABASE_URL=
BOOTSTRAP_ADMIN_USERNAME=choose-an-admin-username
BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-private-password
ATTENDANCE_CORRECTION_WINDOW_HOURS=24
MAX_ATTENDANCE_IMPORT_BYTES=2097152
MAX_ATTENDANCE_IMPORT_ROWS=2000
ATTENDANCE_IMPORT_STAGE_TTL_MINUTES=15
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8
PASSWORD_RESET_LIFETIME_MINUTES=30
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SECURITY_HMAC_KEY=replace-with-a-separate-random-secret
SECURITY_HSTS_MAX_AGE=31536000
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_HOPS=0
